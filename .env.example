# ===========================================================================
# G3TA — Environment Setup
# ===========================================================================
# 1. Copy this file to `.env` at the repo root:
#        cp .env.example .env
# 2. Fill in your own API keys below.
# 3. Restart the backend (uvicorn main:app --reload) — it loads .env automatically.
#
# NEVER commit your real `.env`. It is git-ignored. Share keys via this template only.
# ===========================================================================

# ---- LLM (REQUIRED) --------------------------------------------------------
# DeepSeek powers every agent's reasoning. Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Maps / Geocoding (REQUIRED for real map pins) -------------------------
# Gaode (高德) Web Service API — used for geocoding activity/hotel coordinates.
# Get a key at https://lbs.amap.com/  (免费, 个人开发者即可)
GAODE_KEY=your_gaode_key_here

# ---- Hotel pricing (OPTIONAL but recommended) ------------------------------
# Hotelbeds Test API — real hotel rates. Sign up at https://developer.hotelbeds.com/
# NOTE: the test environment has a daily quota; when exceeded the app falls back
# to Ctrip scraping (real hotel names, estimated prices).
HOTELS_HOTELBEDS_KEY=your_hotelbeds_key_here
HOTELS_HOTELBEDS_SECRET=your_hotelbeds_secret_here
# HOTELS_HOTELBEDS_BASE=https://api.test.hotelbeds.com   # test env (default)

# Other supported hotel providers (configure one; all are optional)
HOTELS_AMADEUS_KEY=
HOTELS_AMADEUS_SECRET=
HOTELS_RAPIDAPI_KEY=
HOTELS_RAPIDAPI_HOST=
HOTELS_TONGCHENG_ACCOUNT=
# HOTELS_TONGCHENG_URL=https://open.lvcang.cn/hotel/list

# Ctrip browser sessions improve live search and payment-checkpoint reliability.
# Use backend/scripts/save_ctrip_cookies.py instead of committing session values.
CTRIP_COOKIE=

# Strict mode is the production default. Set to 1 only for an explicit offline demo.
ALLOW_MOCK_RESULTS=0

# ---- Local Piper text-to-speech --------------------------------------------
# Run the service in ./piper on port 8083. Change this only if Piper is hosted
# elsewhere. The frontend always calls the G3TA backend, never Piper directly.
PIPER_TTS_URL=http://127.0.0.1:8083/synthesize

# Local multilingual Whisper service started by docker-compose.voice.yml.
WHISPER_ASR_URL=http://127.0.0.1:9000/asr

# Optional SQLite locations. Defaults are backend/booking/booking.db and shared.db.
# BOOKING_DB_PATH=/absolute/path/to/booking.db
# SHARED_DB_PATH=/absolute/path/to/shared.db

# ---- Frontend --------------------------------------------------------------
# Base URL the React app calls. Leave blank to use same-origin (Vite dev proxy).
# For a production static build served by the backend, leave this empty.
VITE_API_BASE=

# Google Maps JavaScript API key for the trip map view (Marker/Polyline/InfoWindow).
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API").
VITE_GOOGLE_MAPS_API_KEY=<placeholder>

# Optional AMap JS credentials for the advanced route helper. The map view itself
# renders Gaode tiles without these (no key required), while backend geocoding uses GAODE_KEY.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
