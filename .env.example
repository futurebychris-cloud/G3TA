# ===========================================================================
# G3TA — Environment Setup
# ===========================================================================
# 1. Copy this file to `.env` at the repo root:
#        cp .env.example .env
# 2. Fill in your own API keys below.
# 3. Restart the backend (uvicorn main:app --reload) — it loads .env automatically.
#
# NEVER commit your real `.env`. It is git-ignored. Share keys via this template only.
# ===========================================================================

# ---- LLM (REQUIRED) --------------------------------------------------------
# DeepSeek powers route selection and final synthesis. Get a key at
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Keep interactive planning responsive; agents fall back deterministically.
DEEPSEEK_TIMEOUT_SECONDS=12
DEEPSEEK_MAX_RETRIES=0
# End the user-visible planning request instead of waiting indefinitely.
PLAN_MAX_SECONDS=300

# ---- Maps / Geocoding (REQUIRED for real map pins) -------------------------
# Gaode (高德) Web Service API — used for geocoding activity/hotel coordinates.
# Get a key at https://lbs.amap.com/  (免费, 个人开发者即可)
GAODE_KEY=your_gaode_key_here

# ---- Hotel pricing (OPTIONAL but recommended) ------------------------------
# Hotelbeds Test API — real hotel rates. Sign up at https://developer.hotelbeds.com/
# NOTE: the test environment has a daily quota. Without a provider result, the
# planner omits lodging cost instead of inventing a price.
HOTELS_HOTELBEDS_KEY=your_hotelbeds_key_here
HOTELS_HOTELBEDS_SECRET=your_hotelbeds_secret_here
# HOTELS_HOTELBEDS_BASE=https://api.test.hotelbeds.com   # test env (default)

# ---- Weather (used by the standalone OpenWeather planning module) ---------
# backend/agents/planning_openweather/ — see its README for details.
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Other supported hotel providers (configure one; all are optional)
HOTELS_AMADEUS_KEY=
HOTELS_AMADEUS_SECRET=
HOTELS_RAPIDAPI_KEY=
HOTELS_RAPIDAPI_HOST=
HOTELS_TONGCHENG_ACCOUNT=
# HOTELS_TONGCHENG_URL=https://open.lvcang.cn/hotel/list

# Ctrip browser sessions improve live search and payment-checkpoint reliability.
# Use backend/scripts/save_ctrip_cookies.py instead of committing session values.
CTRIP_COOKIE=

# Strict mode is the production default. Set to 1 only for an explicit offline demo.
ALLOW_MOCK_RESULTS=0

# Slow browser-only budget enrichment is optional; the labeled Numbeo/reference
# index remains available when this is disabled.
BUDGET_PUBLIC_WEB_SEARCH_ENABLED=0
# Known-place catalogs are the fast default; enable best-effort browser
# discovery only when the extra latency and provider fragility are acceptable.
ACTIVITY_PUBLIC_WEB_SEARCH_ENABLED=0
# The deterministic weather/activity packing checklist is complete by default.
PLANNING_LLM_PACKING_ENABLED=0

# ---- Local Piper text-to-speech --------------------------------------------
# Run the service in ./piper on port 8083. Change this only if Piper is hosted
# elsewhere. The frontend always calls the G3TA backend, never Piper directly.
PIPER_TTS_URL=http://127.0.0.1:8083/synthesize

# ---- API security -----------------------------------------------------------
# Comma-separated browser origins. Wildcard CORS is rejected unless the explicit
# development-only ALLOW_INSECURE_CORS=1 override is also set.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Provider browser automation and booking records. ENABLED by default so the
# auto-booking experiments (hotel payment checkpoint + flight/train/restaurant
# browser flows) can run. Set back to 0 to disable all write/automation paths.
BOOKING_AUTOMATION_ENABLED=1
# Shared secret presented by clients via the `X-G3TA-Booking-Token` header.
# When set, every booking call must include it (or is rejected with 401).
# The local frontend sends this from VITE_G3TA_BOOKING_TOKEN in frontend/.env.
# Leave blank only for a trusted localhost demo (the API then allows localhost).
BOOKING_API_TOKEN=f738af94c4e920dd52809f9764b9edd518a75d20ed2977bc
# When automation is enabled it requires PostgreSQL. Never expose this database
# publicly and never commit its password.
# DATABASE_URL=postgresql://g3ta:change-me@localhost:5432/g3ta
#
# Playwright market scraping is remote-only: its CLI refuses to run without a
# PostgreSQL DATABASE_URL and never falls back to the local SQLite file. For a
# GitHub Actions run, store the hosted connection string as a DATABASE_URL
# repository secret (GitHub itself does not host a SQL database).

# Shared planning/cache data uses SQLite when DATABASE_URL is absent.
# SHARED_DB_PATH=/absolute/path/to/shared.db

# Optional offline public-place metadata bundled in backend/data. It never
# contains current prices/availability and is labeled as a repository snapshot.
G3TA_ALLOW_PROVIDER_SNAPSHOTS=0

# ---- Frontend --------------------------------------------------------------
# Base URL the React app calls. Leave blank to use same-origin (Vite dev proxy).
# For a production static build served by the backend, leave this empty.
VITE_API_BASE=

# AMap Web JS API 2.0. These browser-delivered values are visible to visitors;
# restrict the key to the exact localhost/production domains in the AMap console.
# Create a Web JS API key + security code in the AMap console. Destinations
# outside mainland China also require approved overseas map/route permissions.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
