# ===========================================================================
# G3TA — Environment Setup
# ===========================================================================
# 1. Copy this file to `.env` at the repo root:
#        cp .env.example .env
# 2. Fill in your own API keys below.
# 3. Restart the backend (uvicorn main:app --reload) — it loads .env automatically.
#
# NEVER commit your real `.env`. It is git-ignored. Share keys via this template only.
# ===========================================================================

# ---- LLM (REQUIRED) --------------------------------------------------------
# DeepSeek powers every agent's reasoning. Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Maps / Geocoding (REQUIRED for real map pins) -------------------------
# Gaode (高德) Web Service API — used for geocoding activity/hotel coordinates.
# Get a key at https://lbs.amap.com/  (免费, 个人开发者即可)
GAODE_KEY=your_gaode_key_here

# ---- Hotel pricing (OPTIONAL but recommended) ------------------------------
# Hotelbeds Test API — real hotel rates. Sign up at https://developer.hotelbeds.com/
# NOTE: the test environment has a daily quota; when exceeded the app falls back
# to Ctrip scraping (real hotel names, estimated prices).
HOTELS_HOTELBEDS_KEY=your_hotelbeds_key_here
HOTELS_HOTELBEDS_SECRET=your_hotelbeds_secret_here
# HOTELS_HOTELBEDS_BASE=https://api.test.hotelbeds.com   # test env (default)

# ---- Weather (used by the standalone OpenWeather planning module) ---------
# backend/agents/planning_openweather/ — see its README for details.
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# ---- Frontend --------------------------------------------------------------
# Base URL the React app calls. Leave blank to use same-origin (Vite dev proxy).
# For a production static build served by the backend, leave this empty.
VITE_API_BASE=
